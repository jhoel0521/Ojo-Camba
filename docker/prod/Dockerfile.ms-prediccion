# ms-prediccion (ISSUE-31) — pronostico semanal de Casos de Obra.
#
# A diferencia del resto, no hay etapa de build: Python no compila. La imagen es
# la misma que backend/ms-prediccion/Dockerfile, pero con el contexto en la raiz
# del repo, que es como Coolify construye todos los servicios.
#
# Python 3.12 y no la ultima: es la version con wheels estables para pandas,
# numpy y scikit-learn, y evita compilar nada al construir.
FROM python:3.12-slim

WORKDIR /app

COPY backend/ms-prediccion/requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY backend/ms-prediccion/app ./app

# Los modelos se entrenan localmente y se publican dentro de la imagen.
# `modelos/` está ignorado por Git, pero forma parte del contexto local de
# Docker al construir la imagen de producción.
COPY backend/ms-prediccion/modelos ./modelos

# El caché de clima puede montarse como volumen. El usuario sin privilegios
# también necesita permisos para reentrenar o actualizar artefactos.
RUN mkdir -p /app/datos && chown -R nobody:nogroup /app/modelos /app/datos

ENV PYTHONUNBUFFERED=1

USER nobody

EXPOSE 3007

CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "3007"]
