# ms-prediccion (ISSUE-31)
# El driver va en el esquema (psycopg v3). Si copias la URL estilo Nest
# (postgresql:// sin driver), el servicio la normaliza a +psycopg solo.
DATABASE_URL=postgresql+psycopg://ojocamba:ojocamba_secret@localhost:5432/ojocamba
PUERTO=3007

# El entrenamiento NO corre al arrancar: se dispara con POST /entrenar o el CLI.
# En un servidor compartido un entrenamiento desatendido compite por memoria.
ENTRENAR_AL_INICIAR=false
