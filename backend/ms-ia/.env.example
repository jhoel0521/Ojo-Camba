TCP_PORT=3006

MS_ADMIN_HOST=localhost
MS_ADMIN_PORT=3003

MS_REGISTER_HOST=localhost
MS_REGISTER_PORT=3002

# Asistente conversacional del Back Office — LLM vía la API gratuita de Groq (OpenAI-compatible).
# Conseguí una clave gratis en https://console.groq.com/keys y pegala acá en tu .env local.
# NUNCA se commitea con valor real y NUNCA debe llegar al bundle de ningún frontend.
GROQ_API_KEY=
# Opcionales (tienen defaults en el código):
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_BASE_URL=https://api.groq.com/openai/v1
# Modelo con visión, usado solo por el botón "Analizar foto" (sugerencia de hechos).
# Verificá el catalogo vigente en https://console.groq.com/docs/models (los modelos
# con vision de Groq cambian seguido; llama-4-scout dejo de estar disponible).
GROQ_VISION_MODEL=qwen/qwen3.6-27b
